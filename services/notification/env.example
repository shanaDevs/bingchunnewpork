NOTIFY_PORT=4400
NODE_ENV=development
DATABASE_URL=postgresql://user:pass@host:5432/bingchun?sslmode=require
# Same DB as core — keep pool small so all services fit under max_connections
PRISMA_CONNECTION_LIMIT=5
PRISMA_POOL_TIMEOUT=30
PRISMA_CONNECT_TIMEOUT=10

# Must match core so internal calls are trusted both directions
INTERNAL_SERVICE_SECRET=bingchun-internal-dev-secret
CORE_API_URL=http://localhost:4000

REDIS_URL=redis://localhost:6379

FRONTEND_URL=http://localhost:3000
ADMIN_URL=http://localhost:3000/admin
API_BASE_URL=http://localhost:4400

# ── WhatsApp Business Cloud API ──
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# ── Telegram Bot API ──
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# ── SMSlenz gateway ──
SMS_PROVIDER=mock
SMSLENZ_BASE_URL=https://smslenz.lk
SMSLENZ_USER_ID=
SMSLENZ_API_KEY=
SMSLENZ_SENDER_ID=BingChun

# ── Firebase Cloud Messaging (customer/admin push) ──
FIREBASE_SERVICE_ACCOUNT_JSON=
