# Normalize line endings — keeps Windows autocrlf from warning / flipping LF↔CRLF
* text=auto eol=lf

# Explicit binary types
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.avif binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.mp4 binary
*.pdf binary

# Shell scripts must stay LF
*.sh text eol=lf
docker-entrypoint.sh text eol=lf

# Windows scripts
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf
graphify-out/graph.json merge=graphify
