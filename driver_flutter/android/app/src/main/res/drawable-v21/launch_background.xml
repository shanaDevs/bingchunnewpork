<?xml version="1.0" encoding="utf-8"?>
<!-- Splash: brand blue gradient with the logo centred (matches the Flutter startup screen). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="315"
                android:centerColor="@color/splash_bg"
                android:endColor="@color/splash_bg_end"
                android:startColor="@color/splash_bg_start"
                android:type="linear" />
        </shape>
    </item>
    <item>
        <bitmap
            android:gravity="center"
            android:src="@drawable/splash_icon" />
    </item>
</layer-list>
