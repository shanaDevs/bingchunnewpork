<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive icon background: same cyan-to-blue as the artwork's own edges, so any
     launcher mask shape (circle, squircle, square) shows colour, never white. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <gradient
        android:angle="270"
        android:startColor="#02154F"
        android:endColor="#02154F"
        android:type="linear" />
</shape>
