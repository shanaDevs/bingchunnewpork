{
  "name": "bingchun-delivery",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "backend",
    "Frontend",
    "delivery-service",
    "delivery-frontend",
    "services/*"
  ],
  "scripts": {
    "dev": "npm run db:generate && npm run build -w @bingchun/db --ignore-scripts && concurrently -n backend,frontend,delivery,delivery-fe,stickers -c blue,green,magenta,cyan,yellow \"npm run dev:backend\" \"npm run dev:frontend\" \"npm run dev:delivery\" \"npm run dev:delivery-frontend\" \"npm run dev:cup-stickers\"",
    "dev:web": "concurrently -n backend,frontend,stickers -c blue,green,yellow \"npm run dev:backend\" \"npm run dev:frontend\" \"npm run dev:cup-stickers\"",
    "dev:all": "concurrently -n backend,frontend,delivery,orders,payments,notify,stickers -c blue,green,magenta,yellow,cyan,red,white \"npm run dev:backend\" \"npm run dev:frontend\" \"npm run dev:delivery\" \"npm run dev:orders\" \"npm run dev:payments\" \"npm run dev:notify\" \"npm run dev:cup-stickers\"",
    "dev:backend": "npm run dev -w @bingchun/backend",
    "dev:frontend": "npm run dev -w @bingchun/frontend",
    "dev:delivery": "cross-env DELIVERY_LOAD_BACKEND_ENV=true DELIVERY_PORT=4100 npm run dev -w @bingchun/delivery-service",
    "dev:delivery-frontend": "npm run dev -w @bingchun/delivery-frontend",
    "dev:orders": "npm run dev -w @bingchun/order-service",
    "dev:payments": "npm run dev -w @bingchun/payment-service",
    "dev:notify": "npm run dev -w @bingchun/notification-service",
    "dev:cup-stickers": "node tools/cup-sticker-agent/server.mjs",
    "dev:mobile": "cd mobile && ..\\scripts\\flutter.cmd run",
    "dev:driver-android": "cd driver_android && gradlew.bat installDebug",
    "dev:customer": "cd customer_mobile && ..\\scripts\\flutter.cmd run --dart-define=API_BASE=https://bing-chung-b.mp.dartcodes.com",
    "dev:customers": "npm run dev:customer",
    "build": "npm run build --workspaces --if-present",
    "build:backend": "npm run build -w @bingchun/backend",
    "build:frontend": "npm run build -w @bingchun/frontend",
    "build:delivery-frontend": "npm run build -w @bingchun/delivery-frontend",
    "build:delivery": "npm run build -w @bingchun/delivery-service",
    "build:orders": "npm run build -w @bingchun/order-service",
    "build:payments": "npm run build -w @bingchun/payment-service",
    "build:notify": "npm run build -w @bingchun/notification-service",
    "build:settlement": "npm run build -w @bingchun/settlement",
    "build:mobile": "cd mobile && ..\\scripts\\flutter.cmd build apk",
    "build:driver-android": "cd driver_android && gradlew.bat assembleDebug",
    "install:driver-android": "cd driver_android && gradlew.bat installDebug",
    "build:customer": "cd customer_mobile && ..\\scripts\\flutter.cmd build apk --release --target-platform android-arm64 --obfuscate --split-debug-info=build/app/outputs/symbols --dart-define=API_BASE=https://bing-chung-b.mp.dartcodes.com",
    "start:backend": "npm run start -w @bingchun/backend",
    "start:frontend": "npm run start -w @bingchun/frontend",
    "start:delivery-frontend": "npm run start -w @bingchun/delivery-frontend",
    "start:delivery": "npm run start -w @bingchun/delivery-service",
    "start:orders": "npm run start -w @bingchun/order-service",
    "start:payments": "npm run start -w @bingchun/payment-service",
    "start:notify": "npm run start -w @bingchun/notification-service",
    "lint": "npm run lint -w @bingchun/frontend",
    "db:generate": "npm run prisma:generate -w @bingchun/db",
    "db:push": "npm run prisma:push -w @bingchun/db",
    "db:migrate": "npm run prisma:migrate -w @bingchun/db",
    "db:deploy": "npm run prisma:deploy -w @bingchun/db",
    "db:seed": "npm run prisma:seed -w @bingchun/backend",
    "seed:main-branches": "npm run seed:main-branches -w @bingchun/backend",
    "db:backfill-rider-profiles": "npx ts-node backend/scripts/backfill-rider-profiles.ts",
    "db:feed": "npm run feed -w @bingchun/backend",
    "db:migrate:promo": "npm run migrate:promo-columns -w @bingchun/backend",
    "db:studio": "npm run prisma:studio -w @bingchun/backend",
    "install:mobile": "cd mobile && ..\\scripts\\flutter.cmd pub get",
    "install:customer": "cd customer_mobile && ..\\scripts\\flutter.cmd pub get",
    "install:all": "npm install && cd mobile && ..\\scripts\\flutter.cmd pub get && cd ..\\customer_mobile && ..\\scripts\\flutter.cmd pub get",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ui": "playwright test --ui",
    "test:unit": "npm run test -w @bingchun/backend && npm run test -w @bingchun/frontend && npm run test -w @bingchun/delivery-service",
    "test:unit:ui": "npm run test:ui -w @bingchun/backend",
    "test:unit:cov": "npm run test:cov -w @bingchun/backend",
    "test:frontend": "npm run test -w @bingchun/frontend"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3"
  },
  "engines": {
    "node": ">=22"
  }
}
