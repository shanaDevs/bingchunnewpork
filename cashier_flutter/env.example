# Copy to `.env` (git-ignored) and run with:
#   flutter run --dart-define-from-file=.env
# VS Code: the "Cashier (dev)" launch config passes it for you.

# Backend base URL including /api. Empty = build default (debug: http://127.0.0.1:4000/api).
API_BASE_URL=

# Demo sign-ins shown as tap-to-fill cards on the sign-in screen (debug builds only).
# Up to 6 slots: DEMO_<n>_LABEL / DEMO_<n>_NOTE / DEMO_<n>_EMAIL / DEMO_<n>_PASSWORD.
# Seeded accounts (backend/prisma/seed.ts): <branch>.cashier@… / Cashier@123,
# <branch>@… / Branch@123, admin@bingchunsrilanka.lk / Admin@123.
# Pages per account follow the web rules: Delivery / Live Drivers need the DELIVERY /
# LIVE_DRIVERS permission and a delivery-enabled branch; Branch Stock needs STOCK.

DEMO_1_LABEL=Cashier · delivery branch
DEMO_1_NOTE=All pages (Delivery, Live Drivers, Branch Stock)
DEMO_1_EMAIL=
DEMO_1_PASSWORD=

DEMO_2_LABEL=Cashier · pickup-only branch
DEMO_2_NOTE=No Delivery / Live Drivers
DEMO_2_EMAIL=
DEMO_2_PASSWORD=

DEMO_3_LABEL=Branch Admin
DEMO_3_NOTE=Branch manager
DEMO_3_EMAIL=
DEMO_3_PASSWORD=

DEMO_4_LABEL=Super Admin
DEMO_4_NOTE=All branches · branch picker in POS and Stock
DEMO_4_EMAIL=
DEMO_4_PASSWORD=
