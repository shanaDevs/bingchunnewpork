model DeliveryJob {
  id          String            @id @default(uuid())
  storeId     String
  driverId    String?
  title       String
  /// Human-readable ride id, e.g. RIDE-1024
  rideCode    String?           @unique
  status      DeliveryJobStatus @default(SCHEDULED)
  scheduledAt DateTime
  assignedAt  DateTime?
  startedAt   DateTime?
  /// When the rider finished all customer deliveries and began returning to branch.
  returnStartedAt DateTime?
  completedAt DateTime?
  totalCups             Int?
  estimatedDistanceKm   Float?
  estimatedMinutes      Int?
  /// Mirrored from estimatedDistanceKm at creation; kept for older admin/analytics columns.
  totalDistanceKm   Float?
  /// Integer cents (finance); API exposes whole-LKR strings via money boundary.
  totalDeliveryFees Decimal? @db.Decimal(20, 4)
  /// GPS-accumulated distance for the full ride (branch to stops to branch).
  actualDistanceKm  Float?
  /// Simplified actual GPS polyline as JSON [[lat,lng],...].
  actualRoute       String?           @db.Text
  completedLat      Float?
  completedLng      Float?
  /// Set when this job's pickup point is NOT the outlet — e.g. a vehicle-failure
  /// redelivery, where the new rider must collect parcels from the stranded rider's
  /// breakdown spot instead of the branch. Null means "pick up at the store" as usual.
  pickupLat         Float?
  pickupLng         Float?
  pickupLabel       String?
  riderRatingSum    Int               @default(0)
  riderRatingCount  Int               @default(0)
  broadcastedAt     DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  store       Store             @relation(fields: [storeId], references: [id])
  driver      AdminUser?        @relation(fields: [driverId], references: [id])
  jobOrders   DeliveryJobOrder[]
  rejections  DeliveryJobRejection[]
  adminCancellations DeliveryJobAdminCancellation[]

  @@index([storeId, status])
  @@index([driverId, status])
  @@index([status, completedAt])
  @@index([storeId, status, scheduledAt])
  @@schema("delivery")

  @@map("delivery_jobs")
}

