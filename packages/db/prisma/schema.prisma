generator client {
  previewFeatures = ["multiSchema"]
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas    = ["public", "delivery"]
}

enum OrderMode {
  DELIVERY
  TAKEAWAY
  @@schema("public")
}

enum BatchStatus {
  ACTIVE
  DEPLETED
  WRITTEN_OFF
  FROZEN
  @@schema("public")
}

enum BatchType {
  NORMAL
  EMERGENCY
  RESET
  @@schema("public")
}

enum OrderStatus {
  RECEIVED
  PREPARING
  READY
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  @@schema("public")
}

enum CancelReason {
  OUT_OF_STOCK
  CUSTOMER_REQUEST
  PAYMENT_OR_SYSTEM_ISSUE
  @@schema("public")
}

enum PaymentMethod {
  CARD
  PAYHERE
  CASH_ON_DELIVERY
  CASH_AT_COUNTER
  LOYALTY_POINTS
  @@schema("public")
}

/// Online checkout gateway actually used (additive — does not replace PaymentMethod).
enum PaymentGateway {
  PAYHERE
  WEBXPAY
  @@schema("public")
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  @@schema("public")
}

/// Sales channel for an order. Distinct from `Order.platform` (0=web, 1=app analytics).
enum OrderChannel {
  WEB
  APP
  POS
  WHATSAPP
  TELEGRAM
  @@schema("public")
}

enum MessagingChannel {
  WHATSAPP
  TELEGRAM
  @@schema("public")
}

enum ConversationState {
  NEW
  SELECTING_STORE
  BROWSING_PRODUCTS
  SELECTING_PRODUCT
  ADDING_PRODUCT
  VIEWING_CART
  CHECKOUT
  COLLECTING_CUSTOMER_DETAILS
  SELECTING_PAYMENT
  CONFIRMING_ORDER
  ORDER_CREATED
  TRACKING_ORDER
  @@schema("public")
}

enum ChannelMessageDirection {
  INBOUND
  OUTBOUND
  @@schema("public")
}

enum MessageSenderType {
  CUSTOMER
  BOT
  ADMIN
  SYSTEM
  @@schema("public")
}

model Role {
  id    String @id @default(uuid())
  name  String @unique

  users AdminUser[]
  
  @@schema("public")

  @@map("roles")
}

enum DeliveryJobStatus {
  SCHEDULED
  ASSIGNED
  QUEUED
  IN_PROGRESS
  RETURNING
  COMPLETED
  CANCELLED
  VEHICLE_FAILURE
  @@schema("delivery")
}

enum DriverDutyStatus {
  ONLINE
  ON_DELIVERY
  OFF_DUTY
  @@schema("public")
}

enum NotificationType {
  SMS
  EMAIL
  PUSH
  @@schema("public")
}

enum ProductSize {
  REGULAR
  LARGE
  @@schema("public")
}

enum SugarLevel {
  FIFTY
  HUNDRED
  @@schema("public")
}

enum IceLevel {
  LESS_ICE
  NORMAL_ICE
  @@schema("public")
}

model User {
  id                String               @id @default(uuid())
  name              String
  email             String?              @unique
  phone             String               @unique
  passwordHash      String?
  googleId          String?              @unique
  facebookId        String?              @unique
  isEmailVerified   Boolean              @default(false)
  isPhoneVerified   Boolean              @default(true)
  loyaltyPoints     Int                  @default(0)
  notifyEmail       Boolean              @default(true)
  notifySms         Boolean              @default(true)
  notifyPush        Boolean              @default(true)
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  deletedAt         DateTime?
  bannedAt          DateTime?
  bannedReason      String?              @db.Text
  /// Bumped to revoke every customer access and refresh token.
  tokenVersion      Int                  @default(0)
  referredByUserId  String?
  wishlistShareToken String?  @unique

  addresses         Address[]
  cart              Cart?
  orders            Order[]
  stockReservations StoreProductReservation[]
  platformRatings   PlatformRating[]
  riderRatings      RiderRating[]
  productRatings    ProductRating[]
  wishlistItems     WishlistItem[]
  loyaltyTxns       LoyaltyTransaction[]
  notifications         Notification[]
  customerNotifications CustomerNotification[]
  otpRecords            OtpRecord[]
  promotionUsages       PromotionUsage[]
  spinResults           SpinResult[]
  customerChannels      CustomerChannel[]
  conversationSessions  ConversationSession[]
  customerAuditLogs     CustomerAuditLog[]
  referredBy            User?                @relation("UserReferrals", fields: [referredByUserId], references: [id], onDelete: SetNull)
  referrals             User[]               @relation("UserReferrals")

  @@index([referredByUserId])
  @@index([bannedAt])
  @@schema("public")

  @@map("users")
}

/// Maps WhatsApp / Telegram identities to an existing User (avoids duplicate accounts).
model CustomerChannel {
  id             String           @id @default(uuid())
  customerId     String
  channel        MessagingChannel
  externalUserId String
  phoneNumber    String?
  username       String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  customer User @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([channel, externalUserId])
  @@index([customerId])
  @@index([phoneNumber])
  @@schema("public")

  @@map("customer_channels")
}

/// Server-side conversation state for messaging order bots (channel-agnostic).
model ConversationSession {
  id             String            @id @default(uuid())
  channel        MessagingChannel
  externalUserId String
  customerId     String?
  storeId        String?
  state          ConversationState @default(NEW)
  /// Cart lines: [{ productId, productName, quantity, unitPrice, size? }]
  cartJson       Json              @default("[]")
  /// Scratch pad: selectedProductId, pendingQty, checkout fields, lastOrderId, etc.
  contextJson    Json              @default("{}")
  expiresAt      DateTime
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  customer User?  @relation(fields: [customerId], references: [id], onDelete: SetNull)
  store    Store? @relation(fields: [storeId], references: [id], onDelete: SetNull)

  @@unique([channel, externalUserId])
  @@index([state, expiresAt])
  @@index([customerId])
  @@schema("public")

  @@map("conversation_sessions")
}

/// Idempotency + optional admin conversation history for messaging channels.
model ChannelMessage {
  id                  String                  @id @default(uuid())
  channel             MessagingChannel
  externalMessageId   String
  externalUserId      String
  direction           ChannelMessageDirection
  senderType          MessageSenderType       @default(CUSTOMER)
  messageType         String                  @default("text")
  payload             Json?
  bodyText            String?                 @db.Text
  orderId             String?
  processed           Boolean                 @default(false)
  processingStartedAt DateTime?
  createdAt           DateTime                @default(now())

  order Order? @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@unique([channel, externalMessageId])
  @@index([channel, externalUserId, createdAt])
  @@index([channel, externalUserId, senderType, createdAt])
  @@index([channel, direction, processed, createdAt])
  @@index([orderId])
  @@schema("public")

  @@map("channel_messages")
}

model CustomerNotification {
  id          String   @id @default(uuid())
  userId      String
  type        String   @default("ORDER_STATUS")
  title       String
  message     String   @db.Text
  orderId     String?
  orderNumber String?
  status      String?
  read        Boolean  @default(false)
  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
  @@index([userId, createdAt])
  @@schema("public")

  @@map("customer_notifications")
}

model OtpRecord {
  id        String   @id @default(uuid())
  userId    String
  phone     String
  code      String
  attempts  Int      @default(0)
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id])

  @@schema("public")

  @@map("otp_records")
}

model Address {
  id          String   @id @default(uuid())
  userId      String
  label       String   @default("Home")
  addressLine String
  city        String
  district    String
  lat         Float?
  lng         Float?
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders      Order[]

  @@schema("public")

  @@map("addresses")
}

model Store {
  id            String         @id @default(uuid())
  name          String
  code          String?        @unique
  addressLine   String
  city          String
  district      String
  lat           Float
  lng           Float
  phone         String?
  openTime      String         @default("08:00")
  closeTime     String         @default("23:00")
  onlineOrderStartTime String?
  onlineOrderStopTime  String?
  pickupCutoffMinutes  Int            @default(50)
  isActive         Boolean        @default(true)
  isBusy           Boolean        @default(false)
  deliveryEnabled  Boolean        @default(false)
  deliveryOtpRequired Boolean     @default(false)
  /// Override for branch ride-completion geofence (meters). Null = use AppSetting default.
  completionRadiusM Int?
  /// Exact Windows printer queue name for cup stickers on this branch PC (varies per store).
  cupStickerPrinterName String?
  platformDiscountPaybackEnabled Boolean @default(false)
  /// Set when branch admin closes the branch; cleared on Open Branch. Blocks customer online orders.
  branchClosedAt   DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  deliveryZones           DeliveryZone[]
  deliveryAccessLogs      DeliveryAccessLog[]
  orders               Order[]
  adminUsers           AdminUser[]
  accessibleByAdmins   AdminUser[] @relation("adminuseraccessiblestores")
  storeProducts        StoreProduct[]
  adminNotifications   AdminNotification[]
  deliveryJobs         DeliveryJob[]
  wallet                 StoreWallet?
  walletTransactions     WalletTransaction[]
  storeWithdrawals       StoreWithdrawal[]
  commissionSettlements  CommissionSettlement[]
  platformEarnings       PlatformEarning[]
  promotionUsages        PromotionUsage[]
  platformPaybackSettingLogs PlatformPaybackSettingLog[]
  stockAuditLogs         StockAuditLog[]
  stockReservations      StoreProductReservation[]
  stockBatches           StockBatch[]
  stockBatchCounters     StockBatchCounter[]
  stockBatchGroups       StockBatchGroup[]
  conversationSessions   ConversationSession[]
  loyaltyCampaign      LoyaltyCampaign?
  spinWheelOffers      SpinWheelOffer[]

  @@index([isActive, district])
  @@schema("public")

  @@map("stores")
}

model DeliveryZone {
  id          String   @id @default(uuid())
  storeId     String?
  name        String
  radiusKm    Float
  fee         Int
  minOrder    Int      @default(500)
  isActive    Boolean  @default(true)
  isGlobal    Boolean  @default(false)

  store       Store?   @relation(fields: [storeId], references: [id], onDelete: Cascade)
  orders      Order[]

  @@schema("delivery")

  @@map("delivery_zones")
}

model Category {
  id       String    @id @default(uuid())
  name     String    @unique
  slug     String    @unique
  icon     String?
  sortOrder Int      @default(0)
  isActive Boolean   @default(true)

  products Product[]

  @@index([isActive, sortOrder])
  @@schema("public")

  @@map("categories")
}

model Product {
  id          String        @id @default(uuid())
  categoryId  String
  name        String
  slug        String        @unique
  description String?       @db.Text
  ingredients String?       @db.Text
  basePrice   Int
  cost        Int           @default(0)
  imageUrl    String?
  imageUrls   Json?
  tag         String?
  isAvailable Boolean       @default(true)
  isDeliveryAvailable Boolean @default(true)
  isCombo     Boolean       @default(false)
  sortOrder   Int           @default(0)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  category    Category      @relation(fields: [categoryId], references: [id])
  toppings    ProductTopping[]
  cartItems   CartItem[]
  orderItems  OrderItem[]
  storeProducts StoreProduct[]
  ratings       ProductRating[]
  wishlistItems WishlistItem[]
  dailySpecials DailySpecial[]
  stockAuditLogs StockAuditLog[]
  stockReservations StoreProductReservation[]
  stockBatches StockBatch[]
  spinGifts   SpinWheelOffer[]
  loyaltyCampaignGifts LoyaltyCampaign[] @relation("LoyaltyCampaignGiftProduct")

  @@index([categoryId, isAvailable, sortOrder])
  @@schema("public")

  @@map("products")
}

model ProductRating {
  id        String   @id @default(uuid())
  productId String
  userId    String?
  guestName String?  @db.VarChar(100)
  stars     Int
  comment   String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([productId, createdAt])
  @@index([productId, stars])
  @@schema("public")

  @@map("product_ratings")
}

model WishlistItem {
  id        String   @id @default(uuid())
  userId    String
  productId String
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@schema("public")

  @@map("wishlist_items")
}

model DailySpecial {
  id           String   @id @default(uuid())
  productId    String
  specialPrice Int
  startsAt     DateTime
  endsAt       DateTime
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([isActive, startsAt, endsAt])
  @@schema("public")

  @@map("daily_specials")
}

model StoreProduct {
  storeId             String
  productId           String
  stock               Int      @default(0)
  weeklyBaseQty       Int      @default(0)
  weeklyRemainingQty  Int      @default(0)
  weeklyTargetQty     Int      @default(0)
  lowStockThreshold   Int?
  onlineOutOfStockThreshold Int?
  isAvailable         Boolean  @default(true)
  branchDeactivatedAt DateTime?
  updatedAt           DateTime @updatedAt

  store       Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([storeId, productId])
  @@schema("public")

  @@map("store_products")
}

enum StockChangeType {
  ORDER_DEDUCTION
  ORDER_RESTORATION
  MANUAL_ADJUSTMENT
  WEEKLY_RESET
  BATCH_RECEIVED
  BATCH_ADJUSTMENT
  WASTAGE
  EXPIRY_WRITE_OFF
  @@schema("public")
}

enum StoreProductReservationStatus {
  ACTIVE
  COMPLETED
  CANCELLED
  EXPIRED
  @@schema("public")
}

model StoreProductReservation {
  id              String                        @id @default(uuid())
  reservationUuid String
  userId          String?
  cartId          String?
  storeId         String
  productId       String
  quantity        Int
  orderId         String?
  status          StoreProductReservationStatus @default(ACTIVE)
  expiresAt       DateTime
  createdAt       DateTime                      @default(now())
  updatedAt       DateTime                      @updatedAt

  user    User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  cart    Cart?    @relation(fields: [cartId], references: [id], onDelete: SetNull)
  store   Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  product Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  order   Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([reservationUuid])
  @@index([storeId, productId, status])
  @@index([status, expiresAt])
  @@index([userId, status])
  @@index([orderId])
  @@schema("public")

  @@map("store_product_reservations")
}

model StockAuditLog {
  id          String          @id @default(uuid())
  storeId     String
  productId   String
  batchId     String?
  changeType  StockChangeType
  qtyBefore   Int
  qtyChange   Int
  qtyAfter    Int
  orderId       String?
  adminUserId   String?
  adminUserName String?
  note          String?         @db.Text
  createdAt     DateTime        @default(now())

  store       Store           @relation(fields: [storeId], references: [id], onDelete: Cascade)
  product     Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  batch       StockBatch?     @relation(fields: [batchId], references: [id], onDelete: SetNull)
  order       Order?          @relation(fields: [orderId], references: [id], onDelete: SetNull)
  adminUser   AdminUser?      @relation(fields: [adminUserId], references: [id], onDelete: SetNull)

  @@index([storeId, productId])
  @@index([createdAt])
  @@index([changeType])
  @@index([batchId])
  @@schema("public")

  @@map("stock_audit_logs")
}

model StockBatch {
  id               String      @id @default(uuid())
  batchNumber      String
  batchType        BatchType   @default(NORMAL)
  batchGroupId     String?
  storeId          String
  productId        String
  receivedQty      Int
  remainingQty     Int
  receivedAt       DateTime
  unitCost         Int?
  expiryDate       DateTime?
  status           BatchStatus @default(ACTIVE)
  note             String?     @db.Text
  createdByAdminId String?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  store       Store                  @relation(fields: [storeId], references: [id], onDelete: Cascade)
  product     Product                @relation(fields: [productId], references: [id], onDelete: Cascade)
  batchGroup  StockBatchGroup?       @relation(fields: [batchGroupId], references: [id], onDelete: SetNull)
  createdBy   AdminUser?             @relation(fields: [createdByAdminId], references: [id], onDelete: SetNull)
  allocations StockBatchAllocation[]
  auditLogs   StockAuditLog[]

  @@unique([storeId, batchNumber])
  @@index([storeId, productId, status, receivedAt])
  @@index([batchGroupId])
  @@schema("public")

  @@map("stock_batches")
}

model StockBatchGroup {
  id               String   @id @default(uuid())
  storeId          String
  batchNumber      String
  resetDate        DateTime
  note             String?  @db.Text
  createdByAdminId String?
  createdAt        DateTime @default(now())

  store     Store       @relation(fields: [storeId], references: [id], onDelete: Cascade)
  createdBy AdminUser?  @relation(fields: [createdByAdminId], references: [id], onDelete: SetNull)
  batches   StockBatch[]

  @@unique([storeId, batchNumber])
  @@index([storeId, resetDate])
  @@schema("public")

  @@map("stock_batch_groups")
}

model StockBatchAllocation {
  id          String   @id @default(uuid())
  batchId     String
  orderId     String
  orderItemId String?
  storeId     String
  productId   String
  quantity    Int
  reversedQty Int      @default(0)
  createdAt   DateTime @default(now())

  batch     StockBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  order     Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderItem OrderItem? @relation(fields: [orderItemId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([batchId])
  @@index([storeId, productId])
  @@schema("public")

  @@map("stock_batch_allocations")
}

model StockBatchCounter {
  storeId  String
  dateKey  String
  lastSeq  Int      @default(0)

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@id([storeId, dateKey])
  @@schema("public")

  @@map("stock_batch_counters")
}

model Topping {
  id          String           @id @default(uuid())
  name        String           @unique
  extraPrice  Int              @default(0)
  isAvailable Boolean          @default(true)

  products    ProductTopping[]
  cartItems   CartItemTopping[]
  orderItems  OrderItemTopping[]

  @@schema("public")

  @@map("toppings")
}

model ProductTopping {
  productId String
  toppingId String

  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  topping   Topping @relation(fields: [toppingId], references: [id], onDelete: Cascade)

  @@id([productId, toppingId])
  @@schema("public")

  @@map("product_toppings")
}

model Cart {
  id        String     @id @default(uuid())
  userId    String     @unique
  orderMode OrderMode  @default(DELIVERY)
  storeId   String?
  updatedAt DateTime   @updatedAt

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]
  reservations StoreProductReservation[]

  @@schema("public")

  @@map("carts")
}

model CartItem {
  id         String            @id @default(uuid())
  cartId     String
  productId  String
  size       ProductSize       @default(REGULAR)
  sugarLevel SugarLevel?
  iceLevel   IceLevel?
  quantity   Int               @default(1)
  unitPrice  Int

  cart       Cart              @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product    Product           @relation(fields: [productId], references: [id])
  toppings   CartItemTopping[]

  @@schema("public")

  @@map("cart_items")
}

model CartItemTopping {
  cartItemId String
  toppingId  String

  cartItem   CartItem @relation(fields: [cartItemId], references: [id], onDelete: Cascade)
  topping    Topping  @relation(fields: [toppingId], references: [id])

  @@id([cartItemId, toppingId])
  @@schema("public")

  @@map("cart_item_toppings")
}

model Order {
  id              String          @id @default(uuid())
  orderNumber     String          @unique
  /// Unguessable token for public order tracking links (never expose order number alone).
  trackToken      String?         @unique
  /// Client idempotency key for safe checkout retries (one order per key per user).
  idempotencyKey  String?         @unique
  userId          String?
  guestName       String?
  guestPhone      String?
  guestEmail      String?
  storeId         String
  deliveryZoneId  String?
  addressId       String?
  orderMode       OrderMode
  status          OrderStatus     @default(RECEIVED)
  paymentMethod   PaymentMethod
  /// Which online gateway processed CARD/PAYHERE checkout (null for cash/loyalty).
  paymentGateway  PaymentGateway?
  paymentStatus   PaymentStatus   @default(PENDING)
  paymentRef      String?         @unique
  paymentFailureReason String?    @db.Text
  subtotal        Int
  deliveryFee     Int             @default(0)
  convenientFee   Int             @default(0)
  discount        Int             @default(0)
  loyaltyDiscount Int             @default(0)
  total           Int
  prepaidAmount   Int             @default(0)
  /// Amount sent to the online gateway. Item edits are blocked while this is set and unpaid.
  onlineChargeAmount Int?
  cashReceivedAmount Int?
  changeGivenAmount  Int?
  promoCode       String?
  qrCode          String?         @db.Text
  pickupTime      String?
  queuePosition   Int?
  scheduledPickupAt DateTime?
  pickupReminderSent Boolean     @default(false)
  estimatedMinutes Int            @default(30)
  notes           String?         @db.Text
  deliveryAddressLine String?
  deliveryCity        String?
  deliveryDistrict    String?
  deliveryLat         Float?
  deliveryLng         Float?
  platform            Int             @default(0)
  /// Sales channel (WEB / APP / POS / WHATSAPP / TELEGRAM). Prefer this over `platform` for filtering.
  channel             OrderChannel    @default(WEB)
  cancelReason        CancelReason?
  cancelledBy         String?
  /// Order status at the moment it was cancelled (used to credit rider fees after a mid-ride cancel).
  cancelledAtStatus   OrderStatus?
  /// When the customer cancel countdown starts (order placement for cash; payment confirmation for online).
  cancelWindowStartsAt DateTime?
  /// First branch-staff account that acted on this order (accept, collect, complete, or cancel).
  processedByAdminId String?
  processedByName    String?
  processedAt        DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  user            User?           @relation(fields: [userId], references: [id])
  store           Store           @relation(fields: [storeId], references: [id])
  processedBy     AdminUser?      @relation("OrderProcessedBy", fields: [processedByAdminId], references: [id], onDelete: SetNull)
  deliveryZone    DeliveryZone?   @relation(fields: [deliveryZoneId], references: [id])
  address         Address?        @relation(fields: [addressId], references: [id])
  items           OrderItem[]
  statusEvents    OrderStatusEvent[]
  deliveryJobOrders DeliveryJobOrder[]
  platformRating  PlatformRating?
  riderRating     RiderRating?
  deliveryAttempts DeliveryAttempt[]
  deliveryOtps     DeliveryOtp[]
  deliveryEvents   DeliveryEvent[]
  driverComplaints DriverComplaint[]
  meritPointHistory MeritPointHistory[]
  promotionUsages  PromotionUsage[]
  stockAuditLogs   StockAuditLog[]
  stockReservations StoreProductReservation[]
  stockBatchAllocations StockBatchAllocation[]
  channelMessages   ChannelMessage[]
  refund            Refund?

  @@index([storeId, status, orderMode])
  @@index([storeId, status, createdAt])
  @@index([storeId, createdAt])
  @@index([storeId, paymentStatus, createdAt])
