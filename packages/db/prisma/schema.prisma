  AWAITING_OTP
  DELIVERED
  FAILED
  RETURNED_TO_STORE
  @@schema("public")
}

model DriverLocation {
  id          String   @id @default(uuid())
  driverId    String
  jobId       String?
  lat         Float
  lng         Float
  accuracyM   Float?
  speedKph    Float?
  heading     Float?
  batteryPct  Int?
  recordedAt  DateTime @default(now())

  driver AdminUser @relation(fields: [driverId], references: [id], onDelete: Cascade)

  @@index([driverId, recordedAt])
  @@index([jobId, recordedAt])
  @@schema("delivery")

  @@map("driver_locations")
}

model DriverShift {
  id         String    @id @default(uuid())
  driverId   String
  storeId    String
  startedAt  DateTime  @default(now())
  endedAt    DateTime?
  createdAt  DateTime  @default(now())

  driver AdminUser @relation(fields: [driverId], references: [id], onDelete: Cascade)

  @@index([driverId, startedAt])
  @@index([storeId, startedAt])
  @@schema("delivery")

  @@map("driver_shifts")
}

model DriverDevice {
  id               String    @id @default(uuid())
  driverId         String
  deviceId         String
  platform         String?
  fcmToken         String?   @db.Text
  refreshTokenHash String?   @db.Text
  approvedAt       DateTime?
  lastSeenAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  driver AdminUser @relation(fields: [driverId], references: [id], onDelete: Cascade)

  @@unique([driverId, deviceId])
  @@index([deviceId])
  @@schema("delivery")

  @@map("driver_devices")
}

model DeliveryAttempt {
  id         String                  @id @default(uuid())
  orderId    String
  jobId      String
  driverId   String
  attemptNo  Int                     @default(1)
  outcome    DeliveryAttemptOutcome
  note       String?                 @db.Text
  photoUrl   String?
  lat        Float?
  lng        Float?
  createdAt  DateTime                @default(now())

  order  Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  driver AdminUser @relation(fields: [driverId], references: [id])

  @@index([orderId, createdAt])
  @@index([jobId])
  @@schema("delivery")

  @@map("delivery_attempts")
}

model DeliveryOtp {
  id          String    @id @default(uuid())
  orderId     String
  codeHash    String
  attempts    Int       @default(0)
  expiresAt   DateTime
  verifiedAt  DateTime?
  createdAt   DateTime  @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@schema("delivery")

  @@map("delivery_otps")
}

model DeliveryEvent {
  id        String              @id @default(uuid())
  orderId   String
  jobId     String?
  driverId  String?
  state     DeliveryDomainState
  note      String?
  createdAt DateTime            @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
  @@index([jobId, createdAt])
  @@schema("delivery")

  @@map("delivery_events")
}

model DeliveryOutbox {
  id              String    @id @default(uuid())
  type            String
  payload         Json
  idempotencyKey  String    @unique
  attempts        Int       @default(0)
  nextRetryAt     DateTime  @default(now())
  deliveredAt     DateTime?
  lastError       String?   @db.Text
  createdAt       DateTime  @default(now())

  @@index([deliveredAt, nextRetryAt])
  @@schema("delivery")

  @@map("delivery_outbox")
}

enum RefundStatus {
  RECEIVED
  COMPLETE
  REJECTED
  @@schema("public")
}

enum RefundSubmittedBy {
  CUSTOMER
  BRANCH_ADMIN
  @@schema("public")
}

enum SpinOfferType {
  PERCENTAGE
  FIXED
  FREE_DELIVERY
  GIFT
  NO_PRIZE
  @@schema("public")
}

model LoyaltyCampaign {
  id                       String    @id @default(uuid())
  /// null = platform-wide default (exactly one row)
  storeId                  String?   @unique
  offer1Enabled            Boolean   @default(true)
  offer1DiscountType       String    @default("PERCENTAGE")
  offer1DiscountValue      Int       @default(20)
  offer1WebDiscountValue   Int       @default(20)
  offer1AppDiscountValue   Int       @default(30)
  offer1MinSubtotal        Int       @default(0)
  offer2Enabled            Boolean   @default(true)
  offer2DiscountType       String    @default("PERCENTAGE")
  offer2DiscountValue      Int       @default(5)
  offer2RewardType         String    @default("GIFT")
  offer2GiftProductId      String?
  offer2WindowDays         Int       @default(7)
  offer2MinSubtotal        Int       @default(0)
  offer3Enabled            Boolean   @default(true)
  offer3RequiredOrders     Int       @default(3)
  offer3MinOrderAmount     Int       @default(1000)
  offer3WinChanceNumerator Int       @default(1)
  offer3WinChanceDenominator Int     @default(10)
  offer3OptionAMinEach     Int       @default(1500)
  offer3OptionBCombinedMin Int       @default(4500)
  offer3MatchMode          String    @default("A_OR_B")
  isActive                 Boolean   @default(true)
  startsAt                 DateTime?
  expiresAt                DateTime?
  ownership                String?   @default("PLATFORM")
  contributionSource       String?   @default("JASON")
  branchSharePct           Int?      @default(0)
  platformSharePct         Int?      @default(100)
  branchShareSplits        Json?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  store       Store?   @relation(fields: [storeId], references: [id], onDelete: Cascade)
  giftProduct Product? @relation("LoyaltyCampaignGiftProduct", fields: [offer2GiftProductId], references: [id], onDelete: SetNull)

  @@schema("public")

  @@map("loyalty_campaigns")
}

model SpinWheelOffer {
  id             String        @id @default(uuid())
  storeId        String?
  label          String
  description    String?
  offerType      SpinOfferType @default(PERCENTAGE)
  discountValue  Int           @default(0)
  /// Relative win weight (e.g. 40 = 40% when all weights sum to 100)
  winRate        Float         @default(10)
  color          String        @default("#307ef2")
  sortOrder      Int           @default(0)
  isActive       Boolean       @default(true)
  minOrderValue  Int           @default(0)
  giftProductId  String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  results        SpinResult[]
  giftProduct    Product?      @relation(fields: [giftProductId], references: [id], onDelete: SetNull)
  store          Store?        @relation(fields: [storeId], references: [id], onDelete: Cascade)
  deletedAt      DateTime?

  @@index([storeId, isActive])
  @@schema("public")

  @@map("spin_wheel_offers")
}

model SpinResult {
  id         String         @id @default(uuid())
  userId     String?
  guestKey   String?
  clientIp   String?
  offerId    String
  claimCode  String         @unique
  status     String         @default("CLAIMED") // CLAIMED | REDEEMED | EXPIRED | NO_PRIZE
  expiresAt  DateTime
  orderId    String?
  createdAt  DateTime       @default(now())
  redeemedAt DateTime?

  offer SpinWheelOffer @relation(fields: [offerId], references: [id])
  user  User?          @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, status])
  @@index([guestKey, status])
  @@index([clientIp, createdAt])
  @@index([claimCode])
  @@schema("public")

  @@map("spin_results")
}

model CancelReasonConfig {
  id                  String   @id @default(uuid())
  label               String
  value               String   @unique
  minRefundPercentage Float
  maxRefundPercentage Float
  isActive            Boolean  @default(true)
  sortOrder           Int      @default(0)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  refunds             Refund[]

  @@schema("public")

  @@map("cancel_reason_configs")
}

model OrderStatusRefundConfig {
  id               String      @id @default(uuid())
  orderStatus      OrderStatus @unique
  refundPercentage Float
  isActive         Boolean     @default(true)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  @@schema("public")

  @@map("order_status_refund_configs")
}

model Refund {
  id                   String             @id @default(uuid())
  orderId              String             @unique
  customerId           String?
  customerName         String?
  submittedBy          RefundSubmittedBy  @default(CUSTOMER)
  cancellationReason   String
  customReasonText     String?            @db.Text
  cancelledWithinWindow Boolean           @default(false)
  salesTotal           Int
  deliveryFee          Int                @default(0)
  convenienceFee       Int                @default(0)
  orderTotal           Int
  refundPercentage     Float?
  refundAmount         Int?
  penaltyAmount        Int?
  returningSubtotal           Int?
  notReturningSubtotal        Int?
  returningDeliveryFee        Int?
  returningConvenienceFee     Int?
  nonRefundableDeliveryFee    Int?
  nonRefundableConvenienceFee Int?
  additionalGatewayFee        Int?
  cancelReasonConfigId        String?
  configuredMinPercentage     Float?
  configuredMaxPercentage     Float?
  exceededRange               Boolean            @default(false)
  exceededRangeReason           String?            @db.Text
  cancelledAtStatus               OrderStatus?
  configuredStatusRefundPercentage Float?
  status               RefundStatus       @default(RECEIVED)
  adminNotes           String?            @db.Text
  processedByAdminId   String?
  processedAt          DateTime?
  paidAt               DateTime?
  paidByAdminId        String?
  paymentNote          String?            @db.Text
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  order                Order              @relation(fields: [orderId], references: [id], onDelete: Cascade)
  cancelReasonConfig   CancelReasonConfig? @relation(fields: [cancelReasonConfigId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([customerId, status])
  @@index([status, createdAt])
  @@schema("public")

  @@map("refunds")
}

enum MeritEventType {
  INITIAL
  LATE_DELIVERY
  CANCEL_BEFORE_PICKUP
  CONFIRMED_COMPLAINT
  SERIOUS_VIOLATION
  RECOVERY_BONUS
  MANUAL_ADJUSTMENT
  @@schema("public")
}

enum MeritStatusBand {
  EXCELLENT
  GOOD
  AVERAGE
  WARNING
  CRITICAL
  @@schema("public")
}

enum DriverComplaintStatus {
  OPEN
  CONFIRMED
  DISMISSED
  RESOLVED
  @@schema("public")
}

enum DriverBranchRequestType {
  ADD_BRANCH
  CHANGE_BRANCH
  REMOVE_BRANCH
  @@schema("public")
}

enum DriverBranchRequestStatus {
  PENDING
  APPROVED
  REJECTED
  @@schema("public")
}

/// Immutable audit of driver job rejections / pre-pickup cancellations.
model DeliveryJobRejection {
  id        String   @id @default(uuid())
  jobId     String
  driverId  String
  reason    String   @db.Text
  rejectedAt DateTime @default(now())
  createdAt DateTime @default(now())

  job    DeliveryJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  driver AdminUser   @relation(fields: [driverId], references: [id], onDelete: Cascade)

  @@index([jobId, rejectedAt])
  @@index([driverId, rejectedAt])
  @@schema("delivery")

  @@map("delivery_job_rejections")
}

/// HQ admin closed a stuck delivery job (audit trail).
model DeliveryJobAdminCancellation {
  id                  String            @id @default(uuid())
  jobId               String
  cancelledByAdminId  String
  reason              String            @db.Text
  meritDelta          Int?
  previousJobStatus   DeliveryJobStatus
  createdAt           DateTime          @default(now())

  job       DeliveryJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  adminUser AdminUser   @relation(fields: [cancelledByAdminId], references: [id], onDelete: Cascade)

  @@index([jobId, createdAt])
  @@index([cancelledByAdminId, createdAt])
  @@schema("delivery")

  @@map("delivery_job_admin_cancellations")
}

/// Driver-raised complaint against an order.
model DriverComplaint {
  id          String                @id @default(uuid())
  orderId     String
  driverId    String
  storeId     String
  category    String
  description String                @db.Text
  status      DriverComplaintStatus @default(OPEN)
  resolvedAt  DateTime?
  resolvedBy  String?
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  order  Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  driver AdminUser @relation(fields: [driverId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([driverId, createdAt])
  @@index([storeId, status, createdAt])
  @@schema("delivery")

  @@map("driver_complaints")
}

/// Driver request to add or change branch assignment (super-admin approval required).
model DriverBranchRequest {
  id           String                     @id @default(uuid())
  driverId     String
  type         DriverBranchRequestType
  fromStoreId  String?
  toStoreId    String
  reason       String?                    @db.Text
  status       DriverBranchRequestStatus  @default(PENDING)
  reviewedById String?
  reviewedAt   DateTime?
  reviewNote   String?                    @db.Text
  createdAt    DateTime                   @default(now())
  updatedAt    DateTime                   @updatedAt

  driver AdminUser @relation(fields: [driverId], references: [id], onDelete: Cascade)

  @@index([driverId, status])
  @@index([status, createdAt])
  @@schema("delivery")

  @@map("driver_branch_requests")
}

/// In-app + push inbox for rider account events (complaint review, branch request review).
model DriverNotification {
  id              String   @id @default(uuid())
  driverId        String
  type            String   @default("ACCOUNT_UPDATE")
  title           String
  message         String   @db.Text
  complaintId     String?
  branchRequestId String?
  orderId         String?
  orderNumber     String?
  read            Boolean  @default(false)
  createdAt       DateTime @default(now())

  driver AdminUser @relation(fields: [driverId], references: [id], onDelete: Cascade)

  @@index([driverId, read])
  @@index([driverId, createdAt])
  @@schema("delivery")

  @@map("driver_notifications")
}

/// Immutable merit point ledger — never overwrite historical rows.
model MeritPointHistory {
  id             String         @id @default(uuid())
  driverId       String
  orderId        String?
  previousPoints Int
  changedPoints  Int
  newPoints      Int
  reason         String
  eventType      MeritEventType
  createdBy      String         @default("SYSTEM")
  createdAt      DateTime       @default(now())

  driver AdminUser @relation(fields: [driverId], references: [id], onDelete: Cascade)
  order  Order?    @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([driverId, createdAt])
  @@index([orderId])
  @@index([eventType, createdAt])
  @@schema("delivery")

  @@map("merit_point_history")
}

/// Delivery-owned rider ops profile (identity/login stays on public.admin_users).
model RiderProfile {
  id                              String           @id @default(uuid())
  adminUserId                     String           @unique
  pinLookup                       String?
  phone                           String?
  vehicleType                     String?
  vehicleNumber                   String?
  vehicleColor                    String?
  licenseNumber                   String?
  disabilities                    String?          @db.Text
  profilePhotoUrl                 String?
  licenseImageUrl                 String?
  dutyStatus                      DriverDutyStatus @default(OFF_DUTY)
  meritPoints                     Int              @default(100)
  consecutiveSuccessfulDeliveries Int              @default(0)
  sessionVersion                  Int              @default(0)
  createdAt                       DateTime         @default(now())
  updatedAt                       DateTime         @updatedAt

  @@index([pinLookup])
  @@schema("delivery")
  @@map("rider_profiles")
}

enum JasonLedgerType {
  INVESTMENT
  EXPENSE
  @@schema("public")
}

/// Owner-level investments/expenses ledger (JASON admin page). Separate from store wallets.
model JasonLedgerEntry {
  id                String          @id @default(uuid())
  type              JasonLedgerType
  amount            Decimal         @db.Decimal(20, 4)
  description       String          @db.Text
  occurredAt        DateTime        @default(now())
  isActive          Boolean         @default(true)
  createdById       String?
  storeId           String?
  storeWithdrawalId String?
  balanceBefore     Decimal?        @db.Decimal(20, 4)
  balanceAfter      Decimal?        @db.Decimal(20, 4)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([type, occurredAt])
  @@index([occurredAt])
  @@index([storeWithdrawalId])
  @@schema("public")

  @@map("jason_ledger_entries")
}

model CustomerAuditLog {
  id         String    @id @default(uuid())
  adminId    String
  customerId String
  action     String
  reason     String    @db.Text
  createdAt  DateTime  @default(now())

  admin      AdminUser @relation(fields: [adminId], references: [id])
  customer   User      @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId, createdAt])
  @@schema("public")

  @@map("customer_audit_logs")
}
