@echo off
REM Windows 7 / 10 / 11 — native .NET agent, NO Node.js (no ADVAPI32 issue).
title Bing Chun Cup Sticker Agent - Install
cd /d "%~dp0"

echo.
echo Bing Chun cup sticker agent setup
echo  - .NET Framework 4 check
echo  - Native agent EXE ^(no Node.js^)
echo  - Select/detect printer -^> local.env
echo  - Startup auto-start
echo.

call "%~dp0ensure-dotnet.cmd"
if errorlevel 1 (
  echo .NET Framework 4 required. Install then re-run.
  pause
  exit /b 1
)

if not exist "%~dp0BingChunCupStickerAgent.exe" (
  if exist "%~dp0build-helpers.bat" call "%~dp0build-helpers.bat"
)
if not exist "%~dp0BingChunCupStickerAgent.exe" (
  echo ERROR: BingChunCupStickerAgent.exe missing. Copy full folder from build PC.
  pause
  exit /b 1
)
if not exist "%~dp0print-stickers.exe" (
  echo ERROR: print-stickers.exe missing. Copy full folder from build PC.
  pause
  exit /b 1
)

set "PRINTER=%~1"
if "%PRINTER%"=="" if exist "%~dp0detect-printer.exe" (
  for /f "usebackq delims=" %%P in (`"%~dp0detect-printer.exe"`) do set "PRINTER=%%P"
)
if "%PRINTER%"=="" set "PRINTER=bingchun"
echo Using printer: %PRINTER%
echo Tip: BingChunCupStickerSetup.exe = GUI printer picker

(
  echo # Auto-generated by install.bat - native agent, no Node.js
  echo BC_STICKER_API_URL=https://admin.bingchunsrilanka.com/api
  echo BC_STICKER_SECRET=bingchun-cup-sticker-local
  echo BC_STICKER_PRINTER=%PRINTER%
  echo BC_STICKER_PRINTER_PORT=
  echo BC_STICKER_PRINTER_HOST=
  echo BC_STICKER_PRINTER_TCP_PORT=
  echo BC_STICKER_WIDTH_MM=40
  echo BC_STICKER_HEIGHT_MM=30
  echo BC_STICKER_STORE_ID=
  echo BC_STICKER_SILENT=1
) > "%~dp0local.env"

set "STARTUP=%APPDATA%\Microsoft\Windows\Start Menu\Programs\Startup"
set "LNK=%STARTUP%\Bing Chun Cup Sticker Agent.lnk"
set "VBS=%TEMP%\bc-sticker-startup.vbs"
(
  echo Set s = CreateObject("WScript.Shell"^)
  echo Set sc = s.CreateShortcut("%LNK%"^)
  echo sc.TargetPath = "%~dp0BingChunCupStickerAgent.exe"
  echo sc.WorkingDirectory = "%~dp0"
  echo sc.WindowStyle = 7
  echo sc.Description = "Bing Chun cup sticker agent"
  echo sc.Save
) > "%VBS%"
cscript //nologo "%VBS%" >nul 2>&1
del /f /q "%VBS%" >nul 2>&1

echo Starting native agent EXE ^(no bat^)...
taskkill /F /IM BingChunCupStickerAgent.exe >nul 2>&1
start "" "%~dp0BingChunCupStickerAgent.exe"
ping -n 4 127.0.0.1 >nul

echo.
echo Done. No Node.js used.
echo   Health: http://127.0.0.1:9177/health
echo   Printer: %PRINTER%
echo.
pause
exit /b 0
