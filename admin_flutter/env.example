# Copy to `.env` (git-ignored) and run with:
#   flutter run --dart-define-from-file=.env
# Or pass single values with --dart-define=KEY=value.

# Backend base URL including /api. Empty = build default (debug: http://127.0.0.1:4000/api).
API_BASE_URL=

# Demo sign-ins shown as tap-to-fill cards on the sign-in screen (debug builds only).
# Up to 6 slots: DEMO_<n>_LABEL / DEMO_<n>_NOTE / DEMO_<n>_EMAIL / DEMO_<n>_PASSWORD.
# Seeded accounts (backend/prisma/seed.ts): admin@bingchunsrilanka.lk / Admin@123 (super admin),
# <branch>@… / Branch@123 (branch admin). Cashier accounts are refused by this app.
# Branch admin pages follow the account's menu permissions, like the web sidebar.

DEMO_1_LABEL=Super Admin
DEMO_1_NOTE=All branches · analytics, menu, JASON, reports
DEMO_1_EMAIL=
DEMO_1_PASSWORD=

DEMO_2_LABEL=Branch Admin · delivery branch
DEMO_2_NOTE=Orders, refunds, delivery, stock, cashiers, settings
DEMO_2_EMAIL=
DEMO_2_PASSWORD=

DEMO_3_LABEL=Branch Admin · pickup-only branch
DEMO_3_NOTE=No Delivery / Live Drivers
DEMO_3_EMAIL=
DEMO_3_PASSWORD=
