DELIVERY_PORT=4100
NODE_ENV=development
# Behind Next.js / nginx in dev or prod (express-rate-limit + X-Forwarded-For). Optional override.
# TRUST_PROXY=1

# Required — copy from backend/.env or use your Postgres URL (do not rely on backend/.env unless below is set).
# After schema updates (delivery schema): npm run db:deploy from repo root.
DATABASE_URL=postgresql://user:pass@host:5432/bingchun?sslmode=require
# Development only: merge backend/.env when DATABASE_URL is missing there (not for production).
# DELIVERY_LOAD_BACKEND_ENV=true

# Dual-write driver ops to delivery.rider_profiles (after migrate + backfill).
# DELIVERY_RIDER_PROFILE_ENABLED=true
# Publish order-status outbox rows to Redis (core consumer); falls back to HTTP when false or Redis down.
# DELIVERY_INTEGRATION_EVENTS_ENABLED=true
# Optional dedicated DB role URL (defaults to DATABASE_URL).
# DELIVERY_DATABASE_URL=
# Same DB as core — keep pool small so both services fit under max_connections
PRISMA_CONNECTION_LIMIT=3
PRISMA_POOL_TIMEOUT=30
PRISMA_CONNECT_TIMEOUT=10

# Must match core backend so driver JWTs are interchangeable
JWT_SECRET=bingchun-dev-secret-change-in-prod
JWT_REFRESH_SECRET=bingchun-refresh-secret-change-in-prod
# Must match backend DRIVER_PIN_PEPPER
DRIVER_PIN_PEPPER=bingchun-driver-pin-pepper-change-in-prod
JWT_EXPIRES_IN=15m
# M7 — driver access/refresh token lifetimes (device-bound, rotate on refresh)
JWT_DELIVERY_ACCESS_EXPIRES_IN=12h
JWT_DELIVERY_REFRESH_EXPIRES_IN=30d

CORE_API_URL=http://localhost:4000
# Must match backend's INTERNAL_SERVICE_SECRET
INTERNAL_SERVICE_SECRET=bingchun-internal-dev-secret

FRONTEND_URL=http://localhost:3000
ADMIN_URL=http://localhost:3000/admin
DELIVERY_FRONTEND_URL=http://localhost:3100

OSRM_URL=https://router.project-osrm.org
GPS_RETENTION_DAYS=30
REDIS_URL=

# M6 — OTP hashing pepper + code lifetime
DELIVERY_OTP_PEPPER=bingchun-otp-pepper-change-in-prod
DELIVERY_OTP_TTL_MINUTES=15
# Same baseline as core: customer code required on every branch unless set to false
DELIVERY_OTP_REQUIRED=true

# M7 — device approval
DRIVER_DEVICE_AUTO_APPROVE=true

# M7 — optional push notifications (soft-fail when unset)
FIREBASE_SERVICE_ACCOUNT_JSON=

# Required when delivery-service serves GET /delivery-api/me (licence presign).
# Copy from backend/.env (same values as admin-api).
# DO_SPACES_KEY=
# DO_SPACES_SECRET=
# DO_SPACES_BUCKET=
# DO_SPACES_REGION=sgp1
# DO_SPACES_ENDPOINT=
# DO_SPACES_PREFIX=bingchun

# Load testing — set ONLY during a controlled test window on CapRover, then unset.
# Must be >= 32 chars and match bing-chun-core. k6 sends x-load-test-key with -LoadTestKey.
# LOAD_TEST_BYPASS_KEY=your-long-random-secret-at-least-32-characters
