# Copy to .env.local:
#   copy env.example .env.local        (Windows)
#   cp env.example .env.local          (macOS/Linux)
#
# Production Docker/CI: set NEXT_PUBLIC_API_URL=/api at *build* time (see deploy/env.deploy.example).
# /api and /delivery-api are proxied at request time (src/lib/runtimeProxy.ts). Do not default
# BACKEND_URL to localhost in production images — that used to 500 every Staff Login.

# Core backend (auth, stores, notifications) — proxied as /api
NEXT_PUBLIC_API_URL=http://localhost:4000/api
BACKEND_URL=http://localhost:4000
API_PROXY_URL=http://localhost:4000

# Delivery-service — proxied as /delivery-api (default port 4100)
DELIVERY_SERVICE_URL=http://localhost:4100

# Delivery admin APIs use /delivery-api/admin/... by default.
# Set true to force core http://localhost:4000/api/admin/... (debugging only).
# NEXT_PUBLIC_DELIVERY_ADMIN_VIA_CORE=true
