# Copy to .env.deploy and fill in your values:
#   copy env.deploy.example .env.deploy   (Windows)
#   cp env.deploy.example .env.deploy       (macOS/Linux)

CAPROVER_URL=https://captain.bc.dartcodes.com
CAPROVER_APP=bing-chun-delivery-frontend
CAPROVER_APP_TOKEN=your-caprover-app-token

# --- Build-time (docker build --build-arg / CI) ---
# NEXT_PUBLIC_* is baked into the client bundle; CapRover runtime env alone cannot fix a localhost build.
# /api and /delivery-api are proxied at request time (src/app/api/[...path], src/lib/runtimeProxy.ts)
# so CapRover runtime BACKEND_URL / DELIVERY_SERVICE_URL take effect without a rebuild.
# socket.io still uses a build-time rewrite; production builds fall back to
# https://bing-chun-core.bc.dartcodes.com when BACKEND_URL is empty or localhost.
#
# docker build -f delivery-frontend/Dockerfile \
#   --build-arg NEXT_PUBLIC_API_URL=/api \
#   --build-arg BACKEND_URL=https://bing-chun-core.bc.dartcodes.com \
#   --build-arg API_PROXY_URL=https://bing-chun-core.bc.dartcodes.com \
#   --build-arg DELIVERY_SERVICE_URL=http://srv-captain--bing-chun-delivery:4100 \
#   --build-arg NEXT_PUBLIC_SOCKET_URL=https://bing-chun-core.bc.dartcodes.com \
#   --build-arg NEXT_PUBLIC_SITE_URL=https://bing-chun-delivery-frontend.bc.dartcodes.com \
#   -t bingchun-delivery-frontend .

# --- Runtime (CapRover App Configs — set on the app after deploy) ---
# BACKEND_URL=https://bing-chun-core.bc.dartcodes.com
# API_PROXY_URL=https://bing-chun-core.bc.dartcodes.com
# DELIVERY_SERVICE_URL=http://srv-captain--bing-chun-delivery:4100
#
# On bing-chun-core (if admin cookies must work on this subdomain):
# COOKIE_DOMAIN=.bc.dartcodes.com
