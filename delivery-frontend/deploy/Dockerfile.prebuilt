# Pre-built Next.js standalone — no npm install or build on the server
FROM node:22-slim
WORKDIR /app

ENV NODE_ENV=production
ENV TZ=Asia/Colombo
ENV PORT=3100
ENV HOSTNAME=0.0.0.0
ENV BACKEND_URL=
ENV DELIVERY_SERVICE_URL=

COPY .next/standalone ./
COPY .next/static ./delivery-frontend/.next/static
COPY public ./delivery-frontend/public

EXPOSE 3100
CMD ["node", "delivery-frontend/server.js"]
