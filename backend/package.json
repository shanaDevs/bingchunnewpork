{
  "name": "@bingchun/backend",
  "version": "1.0.0",
  "private": true,
  "main": "index.js",
  "scripts": {
    "predev": "npm run build -w @bingchun/db --ignore-scripts && npm run build -w @bingchun/cors && npm run build -w @bingchun/delivery-domain && npm run build -w @bingchun/settlement",
    "dev": "node init && ts-node-dev --respawn --transpile-only --exit-child src/index.ts",
    "build": "node init && tsc",
    "start": "node init && node dist/index.js",
    "prisma:generate": "npm run prisma:generate -w @bingchun/db",
    "prisma:push": "npm run prisma:push -w @bingchun/db",
    "prisma:migrate": "npm run prisma:migrate -w @bingchun/db",
    "prisma:seed": "ts-node --transpile-only prisma/seed.ts",
    "seed:stores": "ts-node --transpile-only prisma/seed-stores.ts",
    "sync:stores-google": "ts-node --transpile-only src/scripts/sync-stores-from-google.ts",
    "migrate:bingchun-menu": "ts-node --transpile-only prisma/migrate-bingchun-menu.ts",
    "prisma:studio": "prisma studio --schema ../packages/db/prisma/schema.prisma",
    "backfill:wallets": "ts-node --transpile-only src/scripts/backfill-wallets.ts",
    "backfill:permissions": "ts-node --transpile-only src/scripts/backfill-default-permissions.ts",
    "seed:payout-test": "ts-node --transpile-only src/scripts/seed-payout-sppc-test.ts",
    "seed:refund-test": "ts-node --transpile-only src/scripts/seed-refund-complete-orders.ts",
    "seed:payback-test": "ts-node --transpile-only src/scripts/seed-platform-payback-order.ts",
    "seed:chamathka": "ts-node --transpile-only src/scripts/seed-chamathka-orders.ts",
    "seed:main-branches": "ts-node --transpile-only src/scripts/reseed-main-branches.ts",
    "backfill:partial-refund-amounts": "ts-node --transpile-only src/scripts/backfill-partial-refund-amounts.ts",
    "backfill:platform-earnings": "ts-node --transpile-only src/scripts/backfill-platform-earnings.ts",
    "migrate:promo-columns": "ts-node --transpile-only src/scripts/migrate-promo-columns.ts",
    "migrate:promotion-shared": "ts-node --transpile-only src/scripts/migrate-promotion-shared.ts",
    "migrate:user-referral": "ts-node --transpile-only src/scripts/migrate-user-referral.ts",
    "migrate:wishlist-share-token": "ts-node --transpile-only src/scripts/migrate-wishlist-share-token.ts",
    "upload:product-images": "ts-node --transpile-only scripts/upload-product-images-to-spaces.ts",
    "privatize:settlement-proofs": "ts-node --transpile-only src/scripts/privatize-settlement-proofs.ts",
    "seed:dummy": "ts-node --transpile-only prisma/seed-dummy-data.ts",
    "seed:dummy-users": "ts-node --transpile-only prisma/seed-dummy-users.ts",
    "seed:nuge-sept1-delivery-shared": "ts-node --transpile-only src/scripts/seed-nugegoda-sept1-delivery-shared-promo-order.ts",
    "seed:nuge-sept2-delivery-platform": "ts-node --transpile-only src/scripts/seed-nugegoda-sept2-delivery-platform-promo-order.ts",
    "seed:nuge-sept2-delivery-refund": "ts-node --transpile-only src/scripts/seed-nugegoda-sept2-delivery-refund-order.ts",
    "seed:nuge-sept3-cash-pickup": "ts-node --transpile-only src/scripts/seed-nugegoda-sept3-cash-pickup-order.ts",
    "seed:nuge-sept4-card-pickup": "ts-node --transpile-only src/scripts/seed-nugegoda-sept4-card-pickup-order.ts",
    "seed:nuge-sept5-15-delivery": "ts-node --transpile-only src/scripts/seed-nugegoda-sept5-15-delivery-promos.ts",
    "seed:nuge-sept16-30-delivery": "ts-node --transpile-only src/scripts/seed-nugegoda-sept16-30-delivery-orders.ts",
    "seed:moratuwa-delivery": "node -r ./scripts/prisma-use-direct-url.cjs ./node_modules/ts-node/dist/bin.js --transpile-only scripts/seed-moratuwa-delivery-orders.ts",
    "seed:nugegoda-delivery": "node -r ./scripts/prisma-use-direct-url.cjs ./node_modules/ts-node/dist/bin.js --transpile-only scripts/seed-nugegoda-delivery-orders.ts",
    "seed:bambalapitiya-delivery": "node -r ./scripts/prisma-use-direct-url.cjs ./node_modules/ts-node/dist/bin.js --transpile-only scripts/seed-bambalapitiya-delivery-orders.ts",
    "inspect:catalog": "ts-node --transpile-only prisma/sync-catalog-from-test.ts inspect",
    "sync:catalog-from-test": "ts-node --transpile-only prisma/sync-catalog-from-test.ts sync",
    "seed:monthly-orders": "ts-node --transpile-only prisma/seed-monthly-orders.ts",
    "seed:nugegoda-app": "ts-node --transpile-only src/scripts/seed-nugegoda-app-orders.ts",
    "seed:nugegoda-app:prod": "node dist/scripts/seed-nugegoda-app-orders.js",
    "audit:nugegoda-seed:prod": "node dist/scripts/audit-nugegoda-seed-readonly.js",
    "feed": "ts-node --transpile-only prisma/seed-dummy-data.ts",
    "db:seed:sql:generate": "ts-node --transpile-only prisma/generate-seed-sql.ts",
    "pretest": "npm run build -w @bingchun/cors && npm run build -w @bingchun/delivery-domain",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:cov": "vitest run --coverage"
  },
  "prisma": {
    "seed": "ts-node --transpile-only prisma/seed.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1091.0",
    "@aws-sdk/s3-request-presigner": "^3.1147.0",
    "@bingchun/cors": "*",
    "@bingchun/db": "*",
    "@bingchun/delivery-domain": "*",
    "@bingchun/settlement": "*",
    "@prisma/client": "^5.22.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "firebase-admin": "^14.0.0",
    "helmet": "^8.2.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.1.1",
    "node-cron": "^4.6.0",
    "node-rsa": "^2.0.0",
    "pdfkit": "^0.18.0",
    "qrcode": "^1.5.4",
    "rate-limit-redis": "^4.2.0",
    "redis": "^4.7.0",
    "socket.io": "^4.8.3",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^14.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.1.0",
    "@types/node-cron": "^3.0.11",
    "@types/pdfkit": "^0.17.6",
    "@types/qrcode": "^1.5.6",
    "@types/uuid": "^10.0.0",
    "@vitest/coverage-v8": "^3.2.7",
    "@vitest/ui": "^3.2.7",
    "prisma": "^5.22.0",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
