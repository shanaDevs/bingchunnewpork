# Copy to .env:
#   copy env.example .env        (Windows)
#   cp env.example .env          (macOS/Linux)

# Required — Prisma / Postgres (or MySQL)
DATABASE_URL="postgresql://user:pass@host:5432/bingchun?sslmode=require"
DB_CONNECT_RETRIES=5
DB_CONNECT_RETRY_MS=2000
# Per-process Prisma pool size. Keep low when backend + delivery-service share one DB.
# Total open ≈ (instances of each app) × PRISMA_CONNECTION_LIMIT — must stay under DB max_connections.
# Production checklist: (backend replicas + delivery-service + other DB clients) × limit < max_connections (leave headroom).
# Development defaults to 2 per process if unset; production defaults to 5.
# With a remote/shared DB, use 2–3 and run `npm run dev:web` (skips delivery-service) unless you need it.
PRISMA_CONNECTION_LIMIT=2
PRISMA_POOL_TIMEOUT=30
PRISMA_CONNECT_TIMEOUT=10

# Docker Compose defaults (if using docker compose up mysql):
# DATABASE_URL="mysql://bingchun:bingchunsecret@localhost:3306/bingchun"

PORT=4000
NODE_ENV=development

JWT_SECRET=bingchun-dev-secret-change-in-prod
JWT_REFRESH_SECRET=bingchun-refresh-secret-change-in-prod
# Dedicated pepper for driver PIN HMAC (recommended). Empty → fall back to JWT_SECRET (legacy dual-read).
DRIVER_PIN_PEPPER=bingchun-driver-pin-pepper-change-in-prod

FRONTEND_URL=http://localhost:3000
# Staff admin UI origin (path optional). Split deploy: https://bing-chun-admin-web.bc.dartcodes.com/admin
ADMIN_URL=http://localhost:3000/admin
# Dedicated admin / POS web hosts (CORS + cookie CSRF origin checks). Match CI ADMIN_WEB_URL / POS_WEB_URL.
# ADMIN_WEB_URL=https://bing-chun-admin-web.bc.dartcodes.com
# POS_WEB_URL=https://bing-chun-pos-web.bc.dartcodes.com
# CORS_EXTRA_ORIGINS=https://staging-admin.example.com
API_BASE_URL=http://localhost:4000

# Google Maps — server geocoding/places + web map tiles (also savable in Admin → Settings).
# Enable Maps JavaScript API, Map Tiles API, Geocoding, Places, Distance Matrix in GCP.
# Browser HTTP referrers: http://localhost:3000/*, http://localhost:3100/*, plus admin/delivery prod hosts.
GOOGLE_MAPS_API_KEY=

# WHATSAPP_APP_SECRET=your-meta-app-secret
#
# Option A — full JSON on one line (escape quotes in CapRover):
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n","client_email":"..."}
#
# Option B — base64 of the downloaded service-account.json file:
# FIREBASE_SERVICE_ACCOUNT_JSON=<base64 string>
#
# Option C — split fields (easiest in CapRover UI):
# FIREBASE_PROJECT_ID=your-project-id
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n
FIREBASE_SERVICE_ACCOUNT_JSON=

# DigitalOcean Spaces (product images and rider profile/licence photos).
# Rider registration fails until KEY, SECRET, and BUCKET are set on the backend app.
# If the bucket name contains a dot, use path-style ENDPOINT (virtual-hosted URLs fail TLS):
#   DO_SPACES_ENDPOINT=https://<region>.digitaloceanspaces.com/<bucket>
DO_SPACES_KEY=
DO_SPACES_SECRET=
DO_SPACES_BUCKET=
DO_SPACES_REGION=sgp1
DO_SPACES_ENDPOINT=
DO_SPACES_PREFIX=bingchun

# Delivery Service integration (optional)
# When true, /api/delivery/* and /auth/delivery/login proxy to the delivery service.
# Keep false for the core cashierBase driver flow (broadcast / claim / dutyStatus).
DELIVERY_SERVICE_ENABLED=false
DELIVERY_SERVICE_URL=http://localhost:4100
# Proxy /api/admin/delivery* (and related paths) to delivery-service /delivery-api/admin/*
DELIVERY_ADMIN_SERVICE_ENABLED=false
# Dual-write driver ops to delivery.rider_profiles (requires db:deploy + backfill-rider-profiles).
DELIVERY_RIDER_PROFILE_ENABLED=false
# Redis stream path for delivery outbox → core (requires REDIS_URL on core + delivery).
DELIVERY_INTEGRATION_EVENTS_ENABLED=false
# GET /orders/:id live map data from delivery-service internal API.
DELIVERY_TRACKING_VIA_SERVICE=false
PAYMENT_SERVICE_ENABLED=false
PAYMENT_SERVICE_URL=http://localhost:4300
INTERNAL_SERVICE_SECRET=bingchun-internal-dev-secret
# Raw driver_locations retention (days). Simplified actualRoute on jobs is kept permanently.
GPS_RETENTION_DAYS=30
REDIS_URL=
# Required when running more than one API replica (or set REQUIRE_REDIS=true explicitly).
# API_REPLICA_COUNT=2
# REQUIRE_REDIS=true

# Delivery OTP — customers give a code to the rider before an order can be marked delivered.
# Required on every branch by default; set to false to fall back to Store.deliveryOtpRequired.
DELIVERY_OTP_REQUIRED=true
DELIVERY_OTP_PEPPER=bingchun-otp-pepper-change-in-prod
DELIVERY_OTP_TTL_MINUTES=15

# ── WhatsApp Business Cloud API (outbound / admin only — inbound Meta webhook disabled) ──
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
# WHATSAPP_APP_SECRET= (optional; only needed if you re-enable /api/whatsapp/webhook)

# ── Telegram Bot API (never expose to frontend) ──
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# ── SMSlenz gateway (OTP + order receipts / pickup-ready / out-for-delivery) ──
# Leave SMS_PROVIDER=mock for local logs without sending. Set smslenz in staging/prod.
SMS_PROVIDER=mock
SMSLENZ_BASE_URL=https://smslenz.lk
SMSLENZ_USER_ID=
SMSLENZ_API_KEY=
SMSLENZ_SENDER_ID=BingChun
SMSLENZ_CONNECTION_TIMEOUT_MS=30000
SMSLENZ_READ_TIMEOUT_MS=30000

# Socket hardening — require JWT on joinUser/joinAdmin/trackOrder (default true in production).
# Do not set SOCKET_AUTH_ENFORCED=false in production (boot will fail).
# SOCKET_AUTH_ENFORCED=true

# Load testing — set ONLY during a controlled test window, then unset.
# Must be >= 32 chars. k6 sends this value as the x-load-test-key header.
# LOAD_TEST_BYPASS_KEY=your-long-random-secret-at-least-32-characters

# ── Social login (Google / Facebook) ──
# Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client ID (Web)
# Authorized JavaScript origins: http://localhost:3000 (and your production URL)
# GOOGLE_CLIENT_ID must match the client ID used by the browser (same value as below).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Meta for Developers → App → Settings → Basic
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
# Facebook Login → Settings → Valid OAuth Redirect URIs:
#   http://localhost:4000/api/auth/facebook/callback
#   https://your-api-domain.com/api/auth/facebook/callback

# Schema — set false after `prisma migrate deploy` is the only schema path
# Set to false after schema is migrated to skip boot-time ALTER TABLE checks (faster restarts).
RUNTIME_SCHEMA_PATCHES=true
