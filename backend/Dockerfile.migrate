# syntax=docker/dockerfile:1
# ============================================================
# Bing Chun — Database Migration Image (one-shot)
# ============================================================
# This image runs `prisma migrate deploy` and exits with 0.
# It is deployed as a separate CapRover app (bing-chun-migrate)
# BEFORE all other services are deployed on every CI run.
#
# Key properties:
#   - Idempotent: prisma migrate deploy is safe to run multiple times
#   - Non-disruptive: does NOT touch any running service
#   - Independent: core, shop, pos, admin do NOT need to restart for migrations
#
# Build from repository root:
#   docker build -f backend/Dockerfile.migrate -t bingchun-migrate .
# ============================================================

# ---- Stage 1: Build (identical to backend/Dockerfile builder stage) ----
FROM node:22-alpine AS builder
WORKDIR /app

ENV NPM_CONFIG_UPDATE_NOTIFIER=false
ENV NPM_CONFIG_CACHE=/tmp/.npm
# prisma generate validates datasource url; no live DB is needed at build time
ENV DATABASE_URL="postgresql://build:build@127.0.0.1:5432/build?schema=public"

RUN apk add --no-cache openssl

COPY package.json package-lock.json* ./
COPY packages/db/package.json ./packages/db/
COPY packages/cors/package.json ./packages/cors/
COPY packages/delivery-domain/package.json ./packages/delivery-domain/
COPY packages/settlement/package.json ./packages/settlement/
COPY backend/package.json ./backend/
COPY delivery-service/package.json ./delivery-service/
COPY Frontend/package.json ./Frontend/

RUN npm install --no-audit --no-fund \
    && npm cache clean --force \
    && rm -rf /tmp/.npm /root/.npm

COPY packages/db ./packages/db
COPY packages/cors ./packages/cors
COPY packages/delivery-domain ./packages/delivery-domain
COPY packages/settlement ./packages/settlement
COPY backend ./backend

RUN npm run prisma:generate -w @bingchun/db

# ---- Stage 2: Minimal migration runner ----
FROM node:22-alpine AS runner
WORKDIR /app

ENV NODE_ENV=production

RUN apk add --no-cache openssl netcat-openbsd postgresql-client

# Only copy what prisma needs: CLI, schema, and generated client
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/packages/db ./packages/db
COPY --from=builder /app/package.json ./package.json

# Migration entrypoint script
COPY backend/migrate-entrypoint.sh ./migrate-entrypoint.sh
RUN chmod +x ./migrate-entrypoint.sh

ENTRYPOINT ["./migrate-entrypoint.sh"]
