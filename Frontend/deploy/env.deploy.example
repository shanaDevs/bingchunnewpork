# Copy to .env.deploy and fill in your values:
#   copy env.deploy.example .env.deploy   (Windows)
#   cp env.deploy.example .env.deploy       (macOS/Linux)

CAPROVER_URL=https://captain.mp.dartcodes.com
CAPROVER_APP=bing-chung
CAPROVER_APP_TOKEN=your-caprover-app-token

# Full backend API URL — BACKEND_URL is derived automatically (strips /api)
API_URL=https://bing-chung-b.mp.dartcodes.com/api

# Or set backend origin directly:
# BACKEND_URL=https://bing-chung-b.mp.dartcodes.com
