# Pre-built Next.js standalone — no npm install or build on the server
# Supports both Frontend (uppercase) and frontend (lowercase) monorepo directory structures
FROM node:22-slim
WORKDIR /app

ENV NODE_ENV=production
ENV TZ=Asia/Colombo
ENV PORT=3000
ENV HOSTNAME=0.0.0.0
# Set BACKEND_URL in CapRover app config (e.g. https://bing-chung-b.mp.dartcodes.com)
ENV BACKEND_URL=
ENV API_PROXY_URL=

COPY .next/standalone ./

# Copy static assets to both Frontend and frontend locations
COPY .next/static ./Frontend/.next/static
COPY public ./Frontend/public

# Ensure fallback symlink for lowercase frontend if referenced
RUN if [ -d /app/Frontend ] && [ ! -d /app/frontend ]; then ln -s /app/Frontend /app/frontend; fi
RUN if [ -d /app/frontend ] && [ ! -d /app/Frontend ]; then ln -s /app/frontend /app/Frontend; fi

EXPOSE 3000

CMD ["sh", "-c", "if [ -f /app/Frontend/server.js ]; then node /app/Frontend/server.js; elif [ -f /app/frontend/server.js ]; then node /app/frontend/server.js; else node /app/server.js; fi"]
