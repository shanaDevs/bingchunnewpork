# Copy to .env:
#   copy env.example .env        (Windows)
#   cp env.example .env          (macOS/Linux)

# Production canonical site URL (used for SEO metadata fallbacks / absolute URLs in some helpers)
NEXT_PUBLIC_SITE_URL=https://bingchunsrilanka.com

# Client API — use `/api` (same-origin proxy) in dev and production. Override only for remote API debugging.
NEXT_PUBLIC_API_URL=/api
NEXT_PUBLIC_SOCKET_URL=http://localhost:4000

# Delivery ops console. Superadmin Delivery / Live Drivers / Delivery Wallet leave the main admin for this origin.
# Production: set the deployed delivery-frontend URL. Dev falls back to http://localhost:3100 when unset.
NEXT_PUBLIC_DELIVERY_FRONTEND_URL=http://localhost:3100

# Backend server origin (Next.js rewrites proxy /api → BACKEND_URL/api)
BACKEND_URL=http://localhost:4000
API_PROXY_URL=http://localhost:4000

# Production example (CapRover frontend app):
# NEXT_PUBLIC_API_URL=/api
# BACKEND_URL=https://bing-chung-b.mp.dartcodes.com
# API_PROXY_URL=https://bing-chung-b.mp.dartcodes.com
# NEXT_PUBLIC_SOCKET_URL=https://bing-chung-b.mp.dartcodes.com
# NEXT_PUBLIC_SITE_URL=https://bingchunsrilanka.com

# SEO / Analytics (optional — see docs/34_SEO_Guide.md)
# Google Analytics 4 Measurement ID, e.g. G-XXXXXXXXXX
NEXT_PUBLIC_GA_ID=
# Google Search Console HTML-tag verification content value only (not the full meta tag)
NEXT_PUBLIC_GSC_VERIFICATION=

# Optional — frontend can also read public IDs from GET /api/auth/social-config when backend .env is set.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_FACEBOOK_APP_ID=
