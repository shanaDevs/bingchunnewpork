<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.BingChunDriver" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@color/bg_light</item>
        <item name="android:navigationBarColor">@color/bg_light</item>
        <item name="android:windowBackground">@color/bg_light</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
    <style name="Theme.BingChunDriver.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/splash_bg</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="postSplashScreenTheme">@style/Theme.BingChunDriver</item>
    </style>
</resources>
